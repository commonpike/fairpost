{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "sourceMap": true,
    "strict" : true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "build"
  },
  "include": [
    "src/**/*"
  ]
}