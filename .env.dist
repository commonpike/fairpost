# FAIRPOST_TWITTER_OA1_API_KEY_SECRET=xxx
# FAIRPOST_TWITTER_OA1_ACCESS_TOKEN=xxx
# FAIRPOST_TWITTER_OA1_ACCESS_SECRET=xxx
FAIRPOST_TWITTER_PLUGINS=LimitFiles,ImageSize


# ---------------
# reddit
